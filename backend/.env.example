# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=ChurnGuard AI
VERSION=1.0.0

# Database
DATABASE_URL=postgresql://churnguard:churnguard@localhost:5432/churnguard_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREDICTIONS=churn_predictions
KAFKA_TOPIC_CAMPAIGNS=automated_campaigns

# ML Models
MODEL_PATH=./models
CHURN_THRESHOLD=0.5
HIGH_RISK_THRESHOLD=0.75

# Integrations (optional - leave empty if not using)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
WOOCOMMERCE_API_KEY=
WOOCOMMERCE_API_SECRET=

# Notifications (optional - leave empty if not using)
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
